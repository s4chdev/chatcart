# ---- Server ----
PORT=3000
# Public URL of this app (PayPal redirects buyers back here after approval)
BASE_URL=http://localhost:3000
SHOP_NAME=Marwar Crafts, Jodhpur
CURRENCY=USD

# ---- PayPal (sandbox) ----
# Leave empty to run with the built-in mock PayPal. Get these from
# https://developer.paypal.com/dashboard/applications/sandbox (Apps & Credentials -> Create App)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Optional: sandbox business account email shown as invoicer
PAYPAL_INVOICER_EMAIL=
# Force mock even if keys are set: PAYPAL_MODE=mock

# ---- LLM (any OpenAI-compatible endpoint with tool calling) ----
# Leave empty to use the scripted rule-based agent.
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=google/gemini-2.0-flash-001
# Gemini:     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Force rule-based agent: LLM_MODE=mock

# ---- Merchant policy (guardrails enforced in code, not just the prompt) ----
AUTO_REFUND_LIMIT=50
REFUND_WINDOW_DAYS=30
BULK_QTY_THRESHOLD=10
# ---- Demo data ----
# Mock mode seeds a realistic demo shop (flagged demo) so the dashboard isn't empty.
# DEMO_SEED=0 starts empty; DEMO_SEED=1 forces it on (demo refunds never touch PayPal).
DEMO_SEED=

# ---- AG Studio merchant dashboard (/dashboard) ----
# Licence key (optional; without it Studio runs as a trial with a watermark)
AG_STUDIO=
# AI assistant: an OpenAI Responses API key. Falls back to LLM_API_KEY/LLM_BASE_URL/LLM_MODEL above
# (the endpoint must support /responses). Leave both empty to hide the assistant.
AG_STUDIO_OPENAI_API_KEY=
# AG_STUDIO_AI_BASE_URL=https://api.openai.com/v1
# Allowed models, comma-separated; the first is the default.
# AG_STUDIO_AI_MODELS=gpt-5.4-mini
# AG_STUDIO_AI_MAX_TOKENS=16000
# AG_STUDIO_AI=off

# Optional: protect /dashboard and merchant APIs with HTTP basic auth (any username)
DASHBOARD_PASSWORD=
